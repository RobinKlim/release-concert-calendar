{
  "name": "release-concert-calendar",
  "version": "1.0.0",
  "description": "Desktop app to track music releases and concerts",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "electron:dev": "npm run build:frontend && electron .",
    "electron:build": "npm run build:frontend && electron-builder",
    "electron:build:mac": "npm run build:frontend && electron-builder --mac",
    "electron:build:linux": "npm run build:frontend && electron-builder --linux",
    "build:frontend": "cd frontend && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "music-metadata": "^9.0.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.release-concert-calendar.app",
    "productName": "Release Concert Calendar",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "!backend/node_modules/**/*",
      "!frontend/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    },
    "npmRebuild": true,
    "asar": false
  }
}
