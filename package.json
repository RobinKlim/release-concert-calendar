{
  "name": "robins-musicbox",
  "version": "1.0.0",
  "description": "Desktop app to track music releases and concerts",
  "author": {
    "name": "Robin Klimczak",
    "email": "klimczak.robin@gmail.com"
  },
  "homepage": "https://github.com/robinklimczak/release-concert-calendar",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "electron:dev": "npm run build:frontend && electron .",
    "electron:build": "npm run build:frontend && electron-builder",
    "electron:build:mac": "npm run build:frontend && electron-builder --mac",
    "electron:build:linux": "npm run build:frontend && electron-builder --linux",
    "build:frontend": "cd frontend && npm run build",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "music-metadata": "^9.0.0",
    "axios": "^1.6.0",
    "node-cron": "^4.2.1",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.robins-musicbox.app",
    "productName": "Robins Musicbox",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "!backend/node_modules/**/*",
      "!frontend/node_modules/**/*",
      "!music-library/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Audio",
      "icon": "assets/icon.png",
      "desktop": {
        "StartupWMClass": "robins-musicbox"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1"
      ],
      "afterInstall": "build/linux/after-install.sh"
    },
    "npmRebuild": true,
    "asar": false
  }
}
